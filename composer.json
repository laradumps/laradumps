{
    "name": "laradumps/laradumps",
    "description": "LaraDumps is a friendly app designed to boost your Laravel PHP coding and debugging experience.",
    "homepage": "https://github.com/laradumps/laradumps",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Luan Freitas",
            "email": "luanfreitas10@protonmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/mail": "^11.0 || ^12.0 || ^13.0",
        "illuminate/events": "^11.0 || ^12.0 || ^13.0",
        "laradumps/laradumps-core": "^4.0.3"
    },
    "require-dev": {
        "orchestra/testbench-core": "^9.4 || ^10.0 || ^11.0",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0",
        "symfony/var-dumper": "^7.1.3|^8.0",
        "pestphp/pest": "^3.7.0 || ^4.0.0",
        "laravel/pint": "^1.26.0",
        "mockery/mockery": "^1.6.12",
        "larastan/larastan": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "LaraDumps\\LaraDumps\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "LaraDumps\\LaraDumps\\Tests\\" : "tests"
        }
    },
    "scripts": {
        "test:pint": "./vendor/bin/pint --test",
        "pint:fix": "./vendor/bin/pint",
        "test:tests": "./vendor/bin/pest --order-by random",
        "test:types": "./vendor/bin/phpstan analyse --ansi --memory-limit=-1",
        "verify": [
            "@test:pint",
            "@test:types",
            "@test:tests"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaraDumps\\LaraDumps\\LaraDumpsServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
